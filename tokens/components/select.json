  "anatomy": {
    "layers": [
      { "name": "container", "role": "trigger surface — background, border, radius, height, inline padding" },
      { "name": "content", "role": "horizontal auto-layout row for prefix, field, clear, and chevron" },
      { "name": "prefix", "role": "optional direct icon instance for leading context; hidden by default" },
      { "name": "field", "role": "content frame for placeholder and selected value text" },
      { "name": "placeholder", "role": "placeholder text shown when no selection is displayed" },
      { "name": "value", "role": "selected option label shown when placeholder is hidden" },
      { "name": "suffix", "role": "suffix group for clear and chevron affordances" },
      { "name": "clear", "role": "optional direct icon instance for allowClear; hidden by default" },
      { "name": "chevron", "role": "direct icon instance for dropdown affordance" },
      { "name": "overlay", "role": "popup surface shown for State=Open" },
      { "name": "menu", "role": "vertical auto-layout list of representative options" },
      { "name": "optionDefault", "role": "default option row" },
      { "name": "optionHover", "role": "hovered option row" },
      { "name": "optionSelected", "role": "selected option row with check icon" }
    ]
  },

