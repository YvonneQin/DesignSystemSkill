      "values": ["large", "default", "small"],
      "antd": "size",
      "default": "default"
    },
    "state": {
      "values": ["closed", "hover", "focused", "open", "disabled"],
      "antd": "disabled maps from the disabled prop; hover/focused/open are design-time previews",
