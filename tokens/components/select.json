  "styleResolution": {
    "rules": [
      "if status=error && state=disabled → styles.error.states.disabled",
      "if status=warning && state=disabled → styles.warning.states.disabled",
      "if status=error → styles.error",
      "if status=warning → styles.warning",
      "else → styles.default"
    ]
  },

  "antd": {
    "import": "import { Select } from 'antd';",
    "notes": {
      "scope": "v1 covers the base single-select trigger and popup preview only. multiple, tags, search input, custom option render, and complex prefix/suffix recipes remain follow-up specs.",
      "state": "State=Open shows the popup for design review. closed, hover, and focused are design-time previews; disabled maps from the antd disabled prop.",
      "status": "status=error|warning follows the Input family validation treatment."
    },
    "examples": {
      "default": "<Select placeholder=\"Please select\" options={options} />",
      "large": "<Select size=\"large\" placeholder=\"Please select\" options={options} />",
      "small": "<Select size=\"small\" placeholder=\"Please select\" options={options} />",
      "error": "<Select status=\"error\" placeholder=\"Please select\" options={options} />",
      "warning": "<Select status=\"warning\" placeholder=\"Please select\" options={options} />",
      "disabled": "<Select disabled placeholder=\"Please select\" options={options} />",
      "prefix": "<Select prefix={<SearchOutlined />} placeholder=\"Search items\" options={options} />",
      "allowClear": "<Select allowClear placeholder=\"Please select\" options={options} />"
    }
  },

  "figmaConventions": {
    "variableMode": "Never set explicit Light/Dark mode on component appearance — inherit from file or page context.",
    "pageContent": "Component pages contain only component sets — no text labels, showcase matrices, doc frames, or instance grids.",
