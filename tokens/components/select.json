      "atomicComponentSetIds": {
        "trigger": "1170:853",
        "option": "1170:884"
      },
      "variantCount": 45,
      "status": "initialized",
      "note": "Initialized as a composed component set on the Select page. The main Select variants now nest *Select / Trigger* and *Select / Option* instances. Status blocks stack vertically, State columns flow horizontally, and Size rows flow vertically. State=Open reveals the popup preview and a selected trigger value."
    },
    "componentProperties": {
      "PrefixIconValue": {
        "type": "INSTANCE_SWAP",
        "default": "Icon / SearchOutlined (509:1318)",
        "bindTo": "prefix.mainComponent",
        "antd": "prefix icon replacement"
      },
      "ShowPrefix": {
        "type": "BOOLEAN",
        "default": false,
        "bindTo": "prefix.visible",
        "antd": "prefix prop visibility"
      },
      "ShowValue": {
        "type": "BOOLEAN",
        "default": false,
        "bindTo": "value.visible",
        "antd": "whether a selected value is displayed"
      },
      "ShowPlaceholder": {
        "type": "BOOLEAN",
        "default": true,
        "bindTo": "placeholder.visible",
        "antd": "placeholder visibility when no value is displayed"
      },
      "ClearIconValue": {
        "type": "INSTANCE_SWAP",
        "default": "Icon / CloseOutlined (509:708)",
        "bindTo": "clear.mainComponent",
        "antd": "allowClear affordance"
      },
      "ShowClear": {
        "type": "BOOLEAN",
        "default": false,
        "bindTo": "clear.visible",
        "antd": "allowClear visibility"
      },
      "ChevronIconValue": {
        "type": "INSTANCE_SWAP",
        "default": "Icon / CaretDownOutlined (509:585)",
        "bindTo": "chevron.mainComponent",
        "antd": "dropdown affordance icon"
      },
      "OverlayVisibility": {
        "type": "DERIVED",
        "default": "State=Open shows overlay; other states hide it",
        "bindTo": "overlay.visible",
        "antd": "design-time popup preview"
      }
    },
    "variantLayout": "Status blocks stacked vertically, State columns horizontally, and Size rows vertically within each state."
  },

