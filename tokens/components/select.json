      "*Select*": "Composed set using extracted trigger and option atomics — Size=Large|Default|Small × State=Closed|Hover|Focused|Open|Disabled × Status=Default|Error|Warning (45 variants)",
      "*Select / Trigger*": "Atomic trigger set — Size=Large|Default|Small × State=Closed|Hover|Focused|Open|Disabled × Status=Default|Error|Warning (45 variants)",
      "*Select / Option*": "Atomic option-row set — Size=Large|Default|Small × Row=Default|Hover|Selected (9 variants)"
    },
    "figmaImplemented": {
      "fileKey": "MwUyizdlqXKyFzHJWvBtI8",
      "pageId": "941:35",
