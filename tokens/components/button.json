  "component": "Button",
  "dna": "control",
  "$extends": "_control-gene.schema.json",
  "variantCount": 450,

  "anatomy": {
    "layers": [
      { "name": "container", "role": "background, border, shadow, padding, radius" },
      { "name": "content", "role": "horizontal flex row — left icon + label + right icon" },
      { "name": "iconLeft", "role": "optional 16×16 direct icon instance — no IconWrapper; mainComponent via IconValue; visibility via ShowLeftIcon" },
      { "name": "label", "role": "button text, default \"Button\" — visibility via ShowContent" },
      { "name": "iconRight", "role": "optional 16×16 direct icon instance — no IconWrapper; mainComponent via IconValue; visibility via ShowRightIcon" }
    ]
  },

  "variants": {
    "type": {
      "values": ["primary", "secondary", "outline", "dashed", "text", "link"],
      "antd": "type",
      "antdMapping": { "outline": "default" },
      "figma": "Type",
      "default": "outline"
    },
    "size": {
      "values": ["large", "default", "small"],
      "antd": "size",
      "default": "default"
    },
    "state": {
      "values": ["default", "hover", "loading", "active", "disabled"],
      "antd": "loading → antd `loading` prop; active → pressed/active interaction; other states are design-time previews",
      "figmaNote": "State=Focused → Loading; State=Pressed → Active"
    },
    "content": {
      "values": ["basic", "iconOnly"],
      "antd": "icon + children"
    },
    "ghost": {
      "values": [false, true],
      "antd": "ghost",
      "default": false,
      "figmaNote": "Current AgentOS Button component set does not expose Ghost as a Figma variant axis"
    },
    "danger": {
      "values": [false, true],
      "antd": "danger",
      "default": false,
      "figmaNote": "Figma uses Theme=Danger instead of Danger=True"
    },
    "theme": {
      "values": ["blue", "black", "danger"],
      "figma": "Theme",
      "default": "blue",
      "mapping": {
        "blue": "Brand/Primary palette — default Ant Design primary",
        "black": "Brand/Secondary palette — Type=Primary uses secondary styles",
        "danger": "Brand/Error palette — maps to danger style blocks"
      }
    },
    "shape": {
      "values": ["default", "round"],
      "antd": "shape",
      "default": "default"
    }
  },

  "naming": {
    "figma": "Theme={Theme}, Type={Type}, Size={Size}, State={State}, Shape={Shape}",
    "example": "Theme=Blue, Type=Primary, Size=Default, State=Loading, Shape=Default"
  },

