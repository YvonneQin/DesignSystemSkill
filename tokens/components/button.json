  "styleResolution": {
    "rules": [
      "if type=primary && danger → primaryDanger",
      "if type=default && danger → defaultDanger",
      "if type=dashed && danger → dashedDanger",
      "if type=primary && ghost → primaryGhost",
      "if type=secondary && danger → secondaryDanger",
      "if type=secondary && ghost → secondaryGhost",
      "if type=text && danger → textDanger",
      "if type=dashed → default styles + borderStyle=dashed",
      "else → styles[type]"
    ]
  },

  "antd": {
    "import": "import { Button } from 'antd';",
    "notes": {
      "secondary": "Custom type — not in Ant Design API. Map to a themed solid button using Brand/Secondary tokens (Base/black)."
    },
    "examples": {
      "primary": "<Button type=\"primary\">Button</Button>",
      "secondary": "<Button type=\"secondary\">Button</Button>",
      "default": "<Button>Button</Button>",
      "dashed": "<Button type=\"dashed\">Button</Button>",
      "text": "<Button type=\"text\">Button</Button>",
      "link": "<Button type=\"link\">Button</Button>",
      "large": "<Button size=\"large\">Button</Button>",
      "small": "<Button size=\"small\">Button</Button>",
      "round": "<Button type=\"primary\" shape=\"round\">Button</Button>",
      "ghost": "<Button type=\"primary\" ghost>Button</Button>",
      "secondaryGhost": "<Button type=\"secondary\" ghost>Button</Button>",
      "danger": "<Button type=\"primary\" danger>Button</Button>",
      "secondaryDanger": "<Button type=\"secondary\" danger>Button</Button>",
      "iconOnly": "<Button type=\"primary\" icon={<SearchOutlined />} />"
    }
  },

  "figmaConventions": {
    "variableMode": "Never set explicit Light/Dark mode on component appearance — inherit from file or page context.",
    "pageContent": "Component pages contain only component sets — no text labels, showcase matrices, doc frames, or instance grids.",
    "componentSets": {
      "*Button*": "Primary + Default + Dashed + Text + Link (Ghost=False, Danger=False) — do NOT duplicate as Button/Primary",
      "Button/Secondary": "Secondary palette — same matrix, Type column uses Secondary instead of Primary",
      "Button/Danger": "Danger=True variants — separate set for red theme"
    },
    "figmaImplemented": {
      "ghost": false,
      "note": "primaryGhost / secondaryGhost defined in styles but not built in Figma yet"
    },
    "variantLayout": "Ant Design matrix inside component set — State blocks (columns) → Type sub-columns → Size rows; no page-level text labels.",
    "borderRadius": {
      "small": "radius/roundedSm4 (4) — Shape=Default only",
      "default": "radius/roundedLg8 (8) — Shape=Default only",
      "large": "radius/roundedLg8 (8) — Shape=Default only",
      "round": "radius/roundedFull999 (999) — all sizes when Shape=Round"
    }
  },

  "mappingCoverage": {
    "mapped": {
      "colors": "Brand/* + Neutral/* (all style background/border/text)",
      "radius": "radius/rounded*",
      "padding": "padding/* (nearest-value)",
      "margin": "margin/marginXs8",
      "controlHeight": "controlHeight/controlHeight*",
      "iconSize": "iconSize/iconSizeMd16",
      "borderWidth": "Border/border-width",
      "typography": "EN/Paragraph 14_h20_Regular, EN/H6 16_h24_Regular",
      "effects": "Component/Button/{primaryShadow,secondaryShadow,defaultShadow,dangerShadow}",
      "transparent": "Neutral/Bg/colorTransparent"
    },
    "gaps": [
      {
        "field": "sizes.*.basicMinWidth",
        "values": [58, 74, 81],
        "reason": "Ant Design component layout constants — no foundation scale",
        "action": "keep as component spec values or add Button/minWidth* tokens later"
      },
      {
        "field": "layout.contentAlign",
        "value": "center",
        "reason": "CSS layout enum, not a variable",
        "action": "hardcode in component"
      },
      {
        "field": "styles.*.borderStyle",
        "values": ["solid", "dashed", "none"],
        "reason": "stroke style enum, not a variable",
        "action": "hardcode per type"
      },
      {
        "field": "typography.baseNormal.antdLineHeight",
        "value": 22,
        "foundation": 20,
        "reason": "EN Paragraph uses 14/20; Ant Design Button uses 14/22",
        "action": "accept Font style or add Button-specific text style"
      },
      {
        "field": "figmaSync.controlHeight",
        "reason": "JSON defined; not yet synced to Vision Token in Figma",
        "action": "run sync script or create variables in Design-System-Test"
      },
      {
        "field": "figmaSync.iconSize",
        "reason": "JSON defined; not yet synced to Vision Token in Figma",
        "action": "create iconSize/* variables in Figma"
      },
      {
        "field": "figmaSync.effects",
        "reason": "Effect styles are Figma local styles, not variables",
        "action": "create Component/Button/* effect styles in your file (copy from Ant Design reference)"
      },
      {
        "field": "figmaSync.colorTransparent",
        "reason": "Added to semantic-bg.json; needs Figma variable",
        "action": "add Neutral/Bg/colorTransparent to ColorMode"
      },
      {
        "field": "styles missing combos",
        "reason": "default+danger, ghost+danger for non-primary types not in styles block",
        "action": "extend styles or derive via styleResolution rules"
      }
    ]
  }
