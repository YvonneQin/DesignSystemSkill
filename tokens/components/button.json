  "styleResolution": {
    "rules": [
      "if theme=danger && type=primary → primaryDanger",
      "if theme=danger && type=outline → outlineDanger",
      "if theme=danger && type=dashed → dashedDanger",
      "if theme=danger && type=text → textDanger",
      "if theme=black && type=outline → outline + border: Brand/Secondary/colorSecondary*",
      "if theme=black && type=dashed → dashed + border: Brand/Secondary/colorSecondary*",
      "if theme=black && type=primary → secondary",
      "if theme=blue && type=primary → primary",
      "if theme=blue && type in (outline,dashed) && state=default → patch border + text + icon: Brand/Primary/colorPrimary",
      "if type=primary && danger → primaryDanger",
      "if type=outline && danger → outlineDanger",
      "if type=dashed && danger → dashedDanger",
      "if type=primary && ghost → primaryGhost",
      "if type=secondary && danger → secondaryDanger",
      "if type=secondary && ghost → secondaryGhost",
      "if type=text && danger → textDanger",
      "if type=dashed → outline styles + borderStyle=dashed",
      "else → styles[type]"
    ]
  },

  "antd": {
    "import": "import { Button } from 'antd';",
    "notes": {
      "secondary": "Custom type — not in Ant Design API. Map to a themed solid button using Brand/Secondary tokens (Base/black).",
      "outline": "Figma Type=Outline maps to antd default (no type prop) — outlined container button."
    },
    "examples": {
      "primary": "<Button type=\"primary\">Button</Button>",
      "secondary": "<Button type=\"secondary\">Button</Button>",
      "outline": "<Button>Button</Button>",
      "dashed": "<Button type=\"dashed\">Button</Button>",
      "text": "<Button type=\"text\">Button</Button>",
      "link": "<Button type=\"link\">Button</Button>",
      "large": "<Button size=\"large\">Button</Button>",
      "small": "<Button size=\"small\">Button</Button>",
      "round": "<Button type=\"primary\" shape=\"round\">Button</Button>",
      "ghost": "<Button type=\"primary\" ghost>Button</Button>",
      "secondaryGhost": "<Button type=\"secondary\" ghost>Button</Button>",
      "danger": "<Button type=\"primary\" danger>Button</Button>",
      "secondaryDanger": "<Button type=\"secondary\" danger>Button</Button>",
      "iconOnly": "<Button type=\"primary\" icon={<SearchOutlined />} />",
      "loading": "<Button type=\"primary\" loading>Button</Button>"
    }
  },

